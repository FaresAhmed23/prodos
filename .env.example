# Prodos backend configuration. Copy to .env and edit: `Copy-Item .env.example .env`
# Every value below is the default baked into backend/app/config.py, so an empty
# .env runs fine locally. Read automatically by pydantic-settings on startup.
#
# .env is gitignored. Never commit a filled-in copy.

# --- Postgres credentials (used by docker-compose.prod.yml only) ------------
# The backend does NOT read these; the compose file interpolates them into
# POSTGRES_PASSWORD and the DATABASE_URL it hands the container. Local runs use
# the default `prodos:prodos` baked into the postgres:16 image, which is why a
# dev DATABASE_URL below works without touching these.
#
# docker-compose.prod.yml uses ${POSTGRES_PASSWORD:?...}, so this is REQUIRED
# there: a missing value aborts `up` instead of deploying the dev credential.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=prodos
POSTGRES_PASSWORD=
POSTGRES_DB=prodos

# --- Ports published by docker-compose.prod.yml -----------------------------
# Change these if something already holds the port on the pilot host.
BACKEND_PORT=8000
MQTT_PORT=1883

# --- Database -------------------------------------------------------------
# SQLAlchemy URL. Docker Desktop local run:
#   postgresql+psycopg://prodos:prodos@localhost:5432/prodos
# From inside docker compose (host `db`):
#   postgresql+psycopg://prodos:prodos@db:5432/prodos
# Do NOT put this in the repo. Set it per-machine.
# docker-compose.prod.yml overrides this with the `db` hostname regardless of
# what you set here, so the same .env works for host-local and in-container runs.
DATABASE_URL=postgresql+psycopg://prodos:prodos@localhost:5432/prodos

# --- MQTT broker ----------------------------------------------------------
# Local Mosquitto from `docker compose up -d mosquitto`, or the `mosquitto`
# service hostname when the backend also runs in Docker.
MQTT_HOST=localhost
MQTT_PORT=1883
# Wildcard subscribe topic. Detection engine subscribes with the same pattern.
MQTT_TOPIC_FRAMES=prodos/sensors/+/frames
# Where the detection engine publishes DetectionEvents. The backend subscribes
# here; §5 pins this as a team-wide contract, so change it only in AGENTS.md too.
MQTT_TOPIC_EVENTS=prodos/events

# --- Owner-side API gate (task F-19) ---------------------------------------
# Optional. When set, /sites endpoints require the same value in X-Admin-Key.
# When unset, those endpoints are open and the backend logs a startup warning.
# LAN pilot only; there is no user system.
ADMIN_API_KEY=

# --- Retention (task F-2) -------------------------------------------------
# Days of frame history to keep. Sweep runs at startup, then hourly.
# Frame volume is ~10 beacons/sec/AP/sensor, so this is what keeps Postgres
# bounded over the 2-week pilot. 0 = purge everything not newer than now.
RETENTION_DAYS=7

# --- AI explanation layer (task F-5) ---------------------------------------
# Leave LLM_API_KEY empty/unset and the backend uses the offline template
# provider, which is the safety net: it always works and needs no network.
# Set the key and the LLM provider is used instead; if the call fails or times
# out, the alert is still delivered with template text.
# Any OpenAI-compatible endpoint works (OpenAI, Ollama, LM Studio, vLLM).
#   OpenAI:  LLM_API_BASE=https://api.openai.com/v1
#   Ollama:  LLM_API_BASE=http://localhost:11434/v1   LLM_API_KEY=ollama
# Base URL must include the /v1 suffix; the path /chat/completions is appended.
# Every call is recorded in the explanation_logs table for fine-tuning later.
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=ollama
LLM_API_KEY=
# Seconds to wait for the model before giving up and using the template.
LLM_TIMEOUT=5.0